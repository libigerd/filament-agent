# Zkopiruj tento soubor jako .env a vygeneruj si vlastni SECRET_KEY:
#   cp .env.example .env
#   python -c 'import secrets, base64; print("LANGFLOW_SECRET_KEY=" + base64.b64encode(secrets.token_bytes(32)).decode())'
#
# Nebo pouzij nasledujici prikaz:
#   openssl rand -base64 32
#
# LANGFLOW_SECRET_KEY musi zustat stabilni, aby Langflow dokazal desifrovat
# ulozene credentials (globalni variables, API klice) i po restartu kontejneru.

LANGFLOW_SECRET_KEY=your-random-32-byte-base64-key-here
